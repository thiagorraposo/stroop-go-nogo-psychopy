      </RoutineSettingsComponent>
      <CodeComponent name="codigo_pratica" plugin="None">
        <Param val="from psychopy import event, core&#10;trial_clock = core.Clock()&#10;hud_state = {&#10;    'practice_completed': 0,&#10;    'practice_correct_count': 0,&#10;    'main_completed': 0,&#10;    'main_correct_count': 0,&#10;    'main_timer_started': False,&#10;}&#10;main_timer_clock = core.Clock()&#10;MAIN_TRIAL_DURATION = 3.75&#10;MAIN_TOTAL_TRIALS = 16&#10;&#10;&#10;def format_accuracy(completed, correct_count):&#10;    if completed == 0:&#10;        return 'Precisão: —'&#10;    return f'Precisão: {round((correct_count / completed) * 100):02d}%'&#10;&#10;&#10;def format_accuracy_bar(completed, correct_count):&#10;    if completed == 0:&#10;        filled = 0&#10;    else:&#10;        filled = round((correct_count / completed) * 10)&#10;    return '[' + ('#' * filled) + ('-' * (10 - filled)) + ']'&#10;&#10;&#10;def format_main_time():&#10;    if not hud_state['main_timer_started']:&#10;        return 'Tempo: 00:00'&#10;    elapsed = min(main_timer_clock.getTime(), MAIN_TRIAL_DURATION * MAIN_TOTAL_TRIALS)&#10;    minutes = int(elapsed // 60)&#10;    seconds = int(elapsed % 60)&#10;    return f'Tempo: {minutes:02d}:{seconds:02d}'&#10;&#10;practice_accuracy_text = format_accuracy(hud_state['practice_completed'], hud_state['practice_correct_count'])&#10;practice_accuracy_bar = format_accuracy_bar(hud_state['practice_completed'], hud_state['practice_correct_count'])&#10;main_accuracy_text = format_accuracy(hud_state['main_completed'], hud_state['main_correct_count'])&#10;main_accuracy_bar = format_accuracy_bar(hud_state['main_completed'], hud_state['main_correct_count'])&#10;timer_text = format_main_time()" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="event.clearEvents(eventType='keyboard')&#10;key_pressed = ''&#10;reaction_time = ''&#10;correct = 0&#10;error_type = ''&#10;feedback_text = ''&#10;block = 'practice'&#10;practice_accuracy_text = format_accuracy(hud_state['practice_completed'], hud_state['practice_correct_count'])&#10;practice_accuracy_bar = format_accuracy_bar(hud_state['practice_completed'], hud_state['practice_correct_count'])&#10;_current_trial_context = create_trial_context(&#10;    block,&#10;    pratica_loop.thisN + 1,&#10;    word,&#10;    ink_color,&#10;    condition,&#10;    correct_response,&#10;)" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="trial_record = build_trial_record(_current_trial_context, resp_pratica)&#10;key_pressed = trial_record['key_pressed']&#10;reaction_time = trial_record['reaction_time']&#10;correct = int(trial_record['correct'])&#10;error_type = trial_record['error_type']&#10;if error_type in ['hit', 'correct_rejection']:&#10;    feedback_text = '✓ Correto'&#10;elif error_type == 'omission':&#10;    feedback_text = 'Pressione ESPAÇO quando a cor combina'&#10;else:&#10;    feedback_text = 'Não responda quando a cor não combina'&#10;official_trial_rows.append(trial_record)&#10;hud_state['practice_completed'] += 1&#10;hud_state['practice_correct_count'] += correct&#10;practice_accuracy_text = format_accuracy(hud_state['practice_completed'], hud_state['practice_correct_count'])&#10;practice_accuracy_bar = format_accuracy_bar(hud_state['practice_completed'], hud_state['practice_correct_count'])" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="codigo_pratica" valType="code" updates="None" name="name" />
      </CodeComponent>
