      <CodeComponent name="formulario_sessao" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="from psychopy import gui, core&amp;#10;from datetime import datetime&amp;#10;import csv&amp;#10;import re&amp;#10;import uuid&amp;#10;&amp;#10;TEST_CODE = 'stroop_go_nogo_ptbr'&amp;#10;TEST_VERSION = '0.1.0'&amp;#10;PARTICIPANT_ID_PATTERN = re.compile(r'^[A-Za-z0-9_-]{2,64}$')&amp;#10;OFFICIAL_CSV_COLUMNS = [&amp;#10;    'project',&amp;#10;    'participant_id',&amp;#10;    'initials',&amp;#10;    'visit',&amp;#10;    'evaluator',&amp;#10;    'assessment_id',&amp;#10;    'assessment_date',&amp;#10;    'started_at',&amp;#10;    'test_code',&amp;#10;    'test_version',&amp;#10;    'block',&amp;#10;    'trial_number',&amp;#10;    'word',&amp;#10;    'ink_color',&amp;#10;    'condition',&amp;#10;    'correct_response',&amp;#10;    'key_pressed',&amp;#10;    'reaction_time',&amp;#10;    'correct',&amp;#10;    'error_type',&amp;#10;]&amp;#10;CONDITION_MAP = {&amp;#10;    'congruente': 'congruent',&amp;#10;    'incongruente': 'incongruent',&amp;#10;    'congruent': 'congruent',&amp;#10;    'incongruent': 'incongruent',&amp;#10;}&amp;#10;&amp;#10;_session_values = {&amp;#10;    'project': '',&amp;#10;    'participant_id': '',&amp;#10;    'initials': '',&amp;#10;    'visit': '',&amp;#10;    'evaluator': '',&amp;#10;}&amp;#10;_session_error = ''&amp;#10;&amp;#10;while True:&amp;#10;    session_dlg = gui.Dlg(&amp;#10;        title='Dados da sessão',&amp;#10;        labelButtonOK='Iniciar tarefa',&amp;#10;        labelButtonCancel='Cancelar',&amp;#10;    )&amp;#10;    session_dlg.addText('Preencha os dados da execução.')&amp;#10;    session_dlg.addText('A data e a hora da avaliação são registradas automaticamente.')&amp;#10;    if _session_error:&amp;#10;        session_dlg.addText(_session_error, color='red')&amp;#10;    session_dlg.addField('Projeto', _session_values['project'])&amp;#10;    session_dlg.addField('ID do participante', _session_values['participant_id'])&amp;#10;    session_dlg.addField('Iniciais (opcional)', _session_values['initials'])&amp;#10;    session_dlg.addField('Visita', _session_values['visit'])&amp;#10;    session_dlg.addField('Avaliador(a)', _session_values['evaluator'])&amp;#10;    dlg_values = session_dlg.show()&amp;#10;&amp;#10;    if not session_dlg.OK:&amp;#10;        core.quit()&amp;#10;&amp;#10;    keys = ['project', 'participant_id', 'initials', 'visit', 'evaluator']&amp;#10;    labels = ['Projeto', 'ID do participante', 'Iniciais (opcional)', 'Visita', 'Avaliador(a)']&amp;#10;    if isinstance(dlg_values, dict):&amp;#10;        raw_values = {key: dlg_values.get(label, '') for key, label in zip(keys, labels)}&amp;#10;    else:&amp;#10;        if dlg_values is None:&amp;#10;            dlg_values = getattr(session_dlg, 'data', [])&amp;#10;        raw_values = {key: value for key, value in zip(keys, dlg_values)}&amp;#10;    _session_values = {key: str(raw_values.get(key, '')).strip() for key in keys}&amp;#10;    validation_errors = []&amp;#10;&amp;#10;    if not _session_values['project']:&amp;#10;        validation_errors.append('Informe o projeto.')&amp;#10;    if not _session_values['participant_id']:&amp;#10;        validation_errors.append('Informe o ID do participante.')&amp;#10;    elif not PARTICIPANT_ID_PATTERN.match(_session_values['participant_id']):&amp;#10;        validation_errors.append('ID do participante: use 2 a 64 caracteres, apenas letras, números, hífen e sublinhado.')&amp;#10;    if not _session_values['visit']:&amp;#10;        validation_errors.append('Informe a visita.')&amp;#10;    if not _session_values['evaluator']:&amp;#10;        validation_errors.append('Informe o avaliador(a).')&amp;#10;&amp;#10;    if not validation_errors:&amp;#10;        break&amp;#10;&amp;#10;    _session_error = 'Corrija os campos: ' + ' '.join(validation_errors)&amp;#10;&amp;#10;_started_at = datetime.now().astimezone().replace(microsecond=0)&amp;#10;expInfo.clear()&amp;#10;expInfo.update(_session_values)&amp;#10;expInfo['assessment_id'] = str(uuid.uuid4())&amp;#10;expInfo['assessment_date'] = _started_at.date().isoformat()&amp;#10;expInfo['started_at'] = _started_at.isoformat()&amp;#10;expInfo['test_code'] = TEST_CODE&amp;#10;expInfo['test_version'] = TEST_VERSION&amp;#10;&amp;#10;_official_assessment_id = expInfo['assessment_id']&amp;#10;official_csv_path = os.path.join('data', f'{_official_assessment_id}.csv')&amp;#10;official_trial_rows = []&amp;#10;official_csv_state = {'written': False}&amp;#10;&amp;#10;&amp;#10;def _canonical_text(value):&amp;#10;    if value in [None, 'None']:&amp;#10;        return ''&amp;#10;    return str(value).strip()&amp;#10;&amp;#10;&amp;#10;def create_trial_context(block_value, trial_number_value, word_value, ink_color_value, condition_value, correct_response_value):&amp;#10;    try:&amp;#10;        trial_index = int(trial_number_value)&amp;#10;    except Exception as exc:&amp;#10;        raise RuntimeError('trial_number invalido para exportacao oficial.') from exc&amp;#10;    if trial_index &lt; 1:&amp;#10;        raise RuntimeError('trial_number deve ser positivo para exportacao oficial.')&amp;#10;&amp;#10;    source_condition = _canonical_text(condition_value).lower()&amp;#10;    canonical_condition = CONDITION_MAP.get(source_condition)&amp;#10;    if canonical_condition is None:&amp;#10;        raise RuntimeError(f'condition invalida para exportacao oficial: {condition_value}')&amp;#10;&amp;#10;    expected_response = 'space' if canonical_condition == 'congruent' else ''&amp;#10;    source_response = _canonical_text(correct_response_value)&amp;#10;    if source_response != expected_response:&amp;#10;        raise RuntimeError('correct_response incompativel com condition na tentativa atual.')&amp;#10;&amp;#10;    return {&amp;#10;        'block': block_value,&amp;#10;        'trial_number': trial_index,&amp;#10;        'word': _canonical_text(word_value),&amp;#10;        'ink_color': _canonical_text(ink_color_value),&amp;#10;        'condition': canonical_condition,&amp;#10;        'correct_response': expected_response,&amp;#10;    }&amp;#10;&amp;#10;&amp;#10;def _extract_keyboard_response(keyboard_component):&amp;#10;    key_pressed_value = ''&amp;#10;    reaction_time_value = ''&amp;#10;    if keyboard_component.keys not in [None, '', []]:&amp;#10;        key_pressed_value = keyboard_component.keys[0] if isinstance(keyboard_component.keys, list) else keyboard_component.keys&amp;#10;        key_pressed_value = _canonical_text(key_pressed_value)&amp;#10;        if key_pressed_value != 'space':&amp;#10;            raise RuntimeError(f'key_pressed invalido para exportacao oficial: {key_pressed_value}')&amp;#10;        if keyboard_component.rt in [None, '', []]:&amp;#10;            raise RuntimeError('reaction_time ausente apesar de haver resposta.')&amp;#10;        reaction_time_raw = keyboard_component.rt[0] if isinstance(keyboard_component.rt, list) else keyboard_component.rt&amp;#10;        reaction_time_float = float(reaction_time_raw)&amp;#10;        if reaction_time_float &lt;= 0:&amp;#10;            raise RuntimeError('reaction_time deve ser maior que zero quando ha resposta.')&amp;#10;        reaction_time_value = f'{reaction_time_float:.6f}'.rstrip('0').rstrip('.')&amp;#10;    return key_pressed_value, reaction_time_value&amp;#10;&amp;#10;&amp;#10;def build_trial_record(trial_context, keyboard_component):&amp;#10;    key_pressed_value, reaction_time_value = _extract_keyboard_response(keyboard_component)&amp;#10;    condition_value = trial_context['condition']&amp;#10;&amp;#10;    if condition_value == 'congruent' and key_pressed_value == 'space':&amp;#10;        correct_value = '1'&amp;#10;        error_type_value = 'hit'&amp;#10;    elif condition_value == 'congruent':&amp;#10;        correct_value = '0'&amp;#10;        error_type_value = 'omission'&amp;#10;    elif key_pressed_value == 'space':&amp;#10;        correct_value = '0'&amp;#10;        error_type_value = 'commission'&amp;#10;    else:&amp;#10;        correct_value = '1'&amp;#10;        error_type_value = 'correct_rejection'&amp;#10;&amp;#10;    row = {&amp;#10;        'project': expInfo['project'],&amp;#10;        'participant_id': expInfo['participant_id'],&amp;#10;        'initials': expInfo['initials'],&amp;#10;        'visit': expInfo['visit'],&amp;#10;        'evaluator': expInfo['evaluator'],&amp;#10;        'assessment_id': expInfo['assessment_id'],&amp;#10;        'assessment_date': expInfo['assessment_date'],&amp;#10;        'started_at': expInfo['started_at'],&amp;#10;        'test_code': expInfo['test_code'],&amp;#10;        'test_version': expInfo['test_version'],&amp;#10;        'block': trial_context['block'],&amp;#10;        'trial_number': str(trial_context['trial_number']),&amp;#10;        'word': trial_context['word'],&amp;#10;        'ink_color': trial_context['ink_color'],&amp;#10;        'condition': condition_value,&amp;#10;        'correct_response': trial_context['correct_response'],&amp;#10;        'key_pressed': key_pressed_value,&amp;#10;        'reaction_time': reaction_time_value,&amp;#10;        'correct': correct_value,&amp;#10;        'error_type': error_type_value,&amp;#10;    }&amp;#10;    validate_official_trial_row(row)&amp;#10;    return row&amp;#10;&amp;#10;&amp;#10;def validate_official_trial_row(row):&amp;#10;    if list(row.keys()) != OFFICIAL_CSV_COLUMNS:&amp;#10;        raise RuntimeError('Colunas oficiais fora da ordem esperada.')&amp;#10;    if row['block'] not in ['practice', 'main']:&amp;#10;        raise RuntimeError('block invalido na exportacao oficial.')&amp;#10;    if row['condition'] not in ['congruent', 'incongruent']:&amp;#10;        raise RuntimeError('condition invalida na exportacao oficial.')&amp;#10;    if row['correct_response'] not in ['', 'space']:&amp;#10;        raise RuntimeError('correct_response invalido na exportacao oficial.')&amp;#10;    if row['key_pressed'] not in ['', 'space']:&amp;#10;        raise RuntimeError('key_pressed invalido na exportacao oficial.')&amp;#10;    if row['correct'] not in ['0', '1']:&amp;#10;        raise RuntimeError('correct invalido na exportacao oficial.')&amp;#10;    if row['error_type'] not in ['hit', 'omission', 'correct_rejection', 'commission']:&amp;#10;        raise RuntimeError('error_type invalido na exportacao oficial.')&amp;#10;    expected_response = 'space' if row['condition'] == 'congruent' else ''&amp;#10;    if row['correct_response'] != expected_response:&amp;#10;        raise RuntimeError('correct_response incoerente com condition.')&amp;#10;    if row['key_pressed'] == 'space' and not row['reaction_time']:&amp;#10;        raise RuntimeError('reaction_time ausente em resposta com Espaco.')&amp;#10;    if row['key_pressed'] == '' and row['reaction_time'] != '':&amp;#10;        raise RuntimeError('reaction_time deve ficar vazio quando nao ha resposta.')&amp;#10;    expected = {&amp;#10;        ('congruent', 'space'): ('1', 'hit'),&amp;#10;        ('congruent', ''): ('0', 'omission'),&amp;#10;        ('incongruent', ''): ('1', 'correct_rejection'),&amp;#10;        ('incongruent', 'space'): ('0', 'commission'),&amp;#10;    }[(row['condition'], row['key_pressed'])]&amp;#10;    if (row['correct'], row['error_type']) != expected:&amp;#10;        raise RuntimeError('correct/error_type incoerentes com condition e key_pressed.')&amp;#10;&amp;#10;&amp;#10;def write_official_csv():&amp;#10;    if official_csv_state['written']:&amp;#10;        return&amp;#10;    if not official_trial_rows:&amp;#10;        raise RuntimeError('Nenhuma tentativa registrada para o CSV oficial.')&amp;#10;    os.makedirs('data', exist_ok=True)&amp;#10;    with open(official_csv_path, 'w', newline='', encoding='utf-8') as file_obj:&amp;#10;        writer = csv.DictWriter(file_obj, fieldnames=OFFICIAL_CSV_COLUMNS, extrasaction='raise')&amp;#10;        writer.writeheader()&amp;#10;        for row in official_trial_rows:&amp;#10;            validate_official_trial_row(row)&amp;#10;            writer.writerow(row)&amp;#10;    official_csv_state['written'] = True" valType="extendedCode" updates="constant" name="Begin Experiment"/>
