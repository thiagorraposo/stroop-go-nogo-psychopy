      <CodeComponent name="formulario_sessao" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment" />
        <Param val="from psychopy import gui, core&#10;from datetime import datetime&#10;import re&#10;import uuid&#10;&#10;TEST_CODE = 'stroop_go_nogo_ptbr'&#10;TEST_VERSION = '0.1.0'&#10;PARTICIPANT_ID_PATTERN = re.compile(r'^[A-Za-z0-9_-]{2,64}$')&#10;&#10;_session_values = {&#10;    'project': '',&#10;    'participant_id': '',&#10;    'initials': '',&#10;    'visit': '',&#10;    'evaluator': '',&#10;}&#10;_session_error = ''&#10;&#10;while True:&#10;    session_dlg = gui.Dlg(&#10;        title='Dados da sessão',&#10;        labelButtonOK='Iniciar tarefa',&#10;        labelButtonCancel='Cancelar',&#10;    )&#10;    session_dlg.addText('Preencha os dados da execução.')&#10;    session_dlg.addText('A data e a hora da avaliação são registradas automaticamente.')&#10;    if _session_error:&#10;        session_dlg.addText(_session_error, color='red')&#10;    session_dlg.addField('Projeto', _session_values['project'])&#10;    session_dlg.addField('ID do participante', _session_values['participant_id'])&#10;    session_dlg.addField('Iniciais (opcional)', _session_values['initials'])&#10;    session_dlg.addField('Visita', _session_values['visit'])&#10;    session_dlg.addField('Avaliador(a)', _session_values['evaluator'])&#10;    dlg_values = session_dlg.show()&#10;&#10;    if not session_dlg.OK:&#10;        core.quit()&#10;&#10;    keys = ['project', 'participant_id', 'initials', 'visit', 'evaluator']&#10;    labels = ['Projeto', 'ID do participante', 'Iniciais (opcional)', 'Visita', 'Avaliador(a)']&#10;    if isinstance(dlg_values, dict):&#10;        raw_values = {key: dlg_values.get(label, '') for key, label in zip(keys, labels)}&#10;    else:&#10;        if dlg_values is None:&#10;            dlg_values = getattr(session_dlg, 'data', [])&#10;        raw_values = {key: value for key, value in zip(keys, dlg_values)}&#10;    _session_values = {key: str(raw_values.get(key, '')).strip() for key in keys}&#10;    validation_errors = []&#10;&#10;    if not _session_values['project']:&#10;        validation_errors.append('Informe o projeto.')&#10;    if not _session_values['participant_id']:&#10;        validation_errors.append('Informe o ID do participante.')&#10;    elif not PARTICIPANT_ID_PATTERN.match(_session_values['participant_id']):&#10;        validation_errors.append('ID do participante: use 2 a 64 caracteres, apenas letras, números, hífen e sublinhado.')&#10;    if not _session_values['visit']:&#10;        validation_errors.append('Informe a visita.')&#10;    if not _session_values['evaluator']:&#10;        validation_errors.append('Informe o avaliador(a).')&#10;&#10;    if not validation_errors:&#10;        break&#10;&#10;    _session_error = 'Corrija os campos: ' + ' '.join(validation_errors)&#10;&#10;_started_at = datetime.now().astimezone().replace(microsecond=0)&#10;expInfo.clear()&#10;expInfo.update(_session_values)&#10;expInfo['assessment_id'] = str(uuid.uuid4())&#10;expInfo['assessment_date'] = _started_at.date().isoformat()&#10;expInfo['started_at'] = _started_at.isoformat()&#10;expInfo['test_code'] = TEST_CODE&#10;expInfo['test_version'] = TEST_VERSION" valType="extendedCode" updates="constant" name="Begin Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine" />
        <Param val="Py" valType="str" updates="None" name="Code Type" />
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame" />
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment" />
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine" />
        <Param val="" valType="extendedCode" updates="constant" name="End Routine" />
        <Param val="False" valType="bool" updates="None" name="disabled" />
        <Param val="formulario_sessao" valType="code" updates="None" name="name" />
      </CodeComponent>
