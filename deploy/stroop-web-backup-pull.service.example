[Unit]
Description=Replica externa de backups WEB criptografados

[Service]
Type=oneshot
UMask=0077
NoNewPrivileges=yes
Nice=19
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=128M
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
ExecStart=/usr/bin/python3 /CLIENTE-IMUTAVEL/scripts/replicate_web_backup.py --config /CONFIGURACAO-PRIVADA/pull.json --status-file /ESTADO-PRIVADO/last-result.json
TimeoutStartSec=420
