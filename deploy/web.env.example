# Template sem secrets. Usar --env-file explicito, nunca ler .env operacional.
WEB_APP_ENV=production
WEB_PUBLIC_ORIGIN=https://research.example.invalid
WEB_OIDC_CALLBACK_PATH=/api/v1/auth/callback
WEB_POSTGRES_DB=stroop_web
WEB_POSTGRES_OWNER=stroop_web_owner
# Preview local por padrao. Exposicao real exige acao manual W22 do usuario.
WEB_BIND_ADDRESS=127.0.0.1
WEB_HTTP_PORT=8088
WEB_HTTPS_PORT=8448
WEB_API_IMAGE=stroop-web-api:local
WEB_PROXY_IMAGE=stroop-web-proxy:local
WEB_ALLOW_SYNTHETIC_CERTIFICATE_FOR_TESTS=0
WEB_POSTGRES_PASSWORD_FILE=/CAMINHO-EXTERNO/postgres_password
WEB_MIGRATION_DATABASE_URL_FILE=/CAMINHO-EXTERNO/migration_database_url
WEB_DATABASE_URL_FILE=/CAMINHO-EXTERNO/api_database_url
WEB_READ_DATABASE_URL_FILE=/CAMINHO-EXTERNO/api_read_database_url
WEB_OIDC_CLIENT_ID_FILE=/CAMINHO-EXTERNO/oidc_client_id
WEB_OIDC_CLIENT_SECRET_FILE=/CAMINHO-EXTERNO/oidc_client_secret
WEB_SESSION_SECRET_FILE=/CAMINHO-EXTERNO/api_session_secret
WEB_TLS_CERTIFICATE_FILE=/CAMINHO-EXTERNO/tls_certificate
WEB_TLS_PRIVATE_KEY_FILE=/CAMINHO-EXTERNO/tls_private_key
