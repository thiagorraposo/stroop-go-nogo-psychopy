# Exemplo exclusivamente ficticio. Nao inicia producao sem secrets externos reais.
POSTGRES_DB=stroop_production
POSTGRES_USER=stroop_application
POSTGRES_PASSWORD=substitua-por-segredo-fora-do-git
DATABASE_URL=postgresql://stroop_application:substitua-por-segredo-fora-do-git@postgres:5432/stroop_production
DASHBOARD_DATABASE_URL=postgresql://stroop_dashboard_ro:substitua-por-segredo-fora-do-git@postgres:5432/stroop_production
AUTH_DATABASE_URL=postgresql://stroop_application:substitua-por-segredo-fora-do-git@postgres:5432/stroop_production
STREAMLIT_SECRETS_FILE=./production-secrets/streamlit-secrets.toml
TLS_CERTIFICATE_FILE=./production-secrets/tls-certificate.pem
TLS_PRIVATE_KEY_FILE=./production-secrets/tls-private-key.pem

# UIDs sem privilegio que devem ser proprietarios dos secrets montados (0600).
APPLICATION_UID=1000
APPLICATION_GID=1000
PROXY_UID=1000
PROXY_GID=1000

# Perfil provisorio para OCI Ampere A1 com 2 OCPUs; total permanente: 1,55 CPU.
POSTGRES_CPUS=0.75
POSTGRES_MEMORY=1536m
DASHBOARD_CPUS=0.65
DASHBOARD_MEMORY=768m
PROXY_CPUS=0.15
PROXY_MEMORY=128m

# Politicas provisorias autorizadas; confirmar com a instituicao antes de dados reais.
OPERATIONAL_LOG_RETENTION_DAYS=30
AUTH_AUDIT_RETENTION_DAYS=180
BACKUP_GENERATIONS=30
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
