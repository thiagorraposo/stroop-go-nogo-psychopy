# Exemplo exclusivamente ficticio. Copie para secrets.toml e substitua os valores.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# Gere pelo menos 32 bytes aleatorios; este marcador nao e uma credencial.
cookie_secret = "<substituir>"

[auth.google]
client_id = "cliente-google-ficticio.apps.googleusercontent.com"
client_secret = "<substituir>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { prompt = "select_account" }
