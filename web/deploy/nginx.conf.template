worker_processes 2;
pid /tmp/nginx.pid;
error_log /dev/null emerg;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    client_max_body_size 64k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    send_timeout 30s;
    keepalive_timeout 15s;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 2s;
    map $https $web_hsts { default ""; on "max-age=31536000"; }
    map $request_method $safe_method { default OTHER; GET GET; POST POST; PUT PUT; PATCH PATCH; DELETE DELETE; HEAD HEAD; OPTIONS OPTIONS; }
    log_format safe escape=json '{"request_id":"$request_id","method":"$safe_method","status":$status,"duration":$request_time}';
    access_log /dev/stdout safe;
    limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=10r/s;
    limit_req_status 429;
    limit_conn_zone $binary_remote_addr zone=connections_per_ip:10m;
    limit_conn_status 429;
    limit_conn connections_per_ip 20;
    server {
        listen 8081;
        access_log off;
        allow 127.0.0.1;
        allow ::1;
        deny all;
        location = /health/live { default_type application/json; return 200 '{"status":"ok"}'; }
        location / { return 404; }
    }
    server {
        listen 8080 default_server;
        server_name _;
        include /etc/nginx/web/error-headers.conf;
        include /etc/nginx/web/closed-errors.conf;
        # Destino fixo, independente de Host/Forwarded fornecidos pelo cliente.
        return 308 ${WEB_PUBLIC_ORIGIN}$request_uri;
    }
    server {
        listen 8443 ssl default_server;
        server_name _;
        ssl_certificate /run/secrets/tls_certificate;
        ssl_certificate_key /run/secrets/tls_private_key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE+AESGCM:ECDHE+CHACHA20;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 10m;
        ssl_session_tickets off;
        if ($http_host != "${WEB_AUTHORITY}") { return 400; }
        root /usr/share/nginx/html;
        include /etc/nginx/web/web-headers.conf;
        include /etc/nginx/web/closed-errors.conf;
        location = /api { include /etc/nginx/web/proxy.conf; }
        location ^~ /api/ { include /etc/nginx/web/proxy.conf; }
        location = /health/live { include /etc/nginx/web/proxy.conf; }
        location = /health/ready { include /etc/nginx/web/proxy.conf; }
        location ^~ /health/ { return 404; }
        location ~ (^|/)\. { return 404; }
        location ~* ^/(src|tests?|e2e|condicoes|docs|node_modules|scripts|web|production-secrets)(/|$) { return 404; }
        location ~* (Dockerfile|package(-lock)?\.json|tsconfig\.json|security-headers\.json|vite\.config|\.map$|\.py$|\.ts$|\.tsx$|\.sql$|\.pem$|\.key$|\.sqlite3?$) { return 404; }
        location ^~ /assets/ { try_files $uri =404; }
        location / {
            if ($request_method !~ ^(GET|HEAD)$) { return 405; }
            try_files $uri $uri/ /index.html;
        }
    }
}
